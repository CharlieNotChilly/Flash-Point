#!/usr/bin/env ruby
require_relative "../config/environment"
require_relative "../lib/stock_invariant"

design = ARGV.first || ENV.fetch("DESIGN", "locked")
abort "Usage: bin/check_invariant [naive|locked|flashpoint]" unless %w[naive locked flashpoint].include?(design)
StockInvariant.wait_for_pending! if design == "flashpoint"

# Read stock and orders from the same PostgreSQL snapshot.
report = Product.transaction(isolation: :repeatable_read) { StockInvariant.read("FLASH-1", design: design) }
report.to_h.each { |field, value| puts "#{field}=#{value}" }
puts "oversold=#{report.oversold}"
puts "invariant=#{report.valid? ? 'PASS' : 'FAIL'}"
exit(report.valid? ? 0 : 1)
